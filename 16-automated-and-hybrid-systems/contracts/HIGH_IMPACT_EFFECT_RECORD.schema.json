{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "High-Impact Effect Record",
  "type": "object",
  "required": ["record_id", "effect_type", "affected_scope", "accountable_principal_record_id", "authority_chain_record_id", "jurisdiction_record_id", "system_participation_record_id", "predicate_assessment_record_id", "evidence_record_ids", "consequence_gate_record_id", "review_route", "remedy_route", "status"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "effect_type": { "type": "string", "minLength": 1 },
    "affected_scope": { "type": "string", "minLength": 1 },
    "accountable_principal_record_id": { "type": "string", "minLength": 1 },
    "authority_chain_record_id": { "type": "string", "minLength": 1 },
    "delegation_record_id": { "type": "string" },
    "jurisdiction_record_id": { "type": "string", "minLength": 1 },
    "system_participation_record_id": { "type": "string", "minLength": 1 },
    "predicate_assessment_record_id": { "type": "string", "minLength": 1 },
    "evidence_record_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "consequence_gate_record_id": { "type": "string", "minLength": 1 },
    "review_route": { "type": "string", "minLength": 1 },
    "remedy_route": { "type": "string", "minLength": 1 },
    "stop_or_revocation_condition": { "type": "string" },
    "effect_receipt_record_id": { "type": "string" },
    "status": { "enum": ["observation_only", "recommended", "blocked", "pending_review", "eligible_for_execution", "executed", "corrected"] }
  },
  "additionalProperties": false
}