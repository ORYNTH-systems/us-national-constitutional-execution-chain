{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legislative Lineage Record",
  "type": "object",
  "required": ["record_id", "measure_identifier", "congress", "action_type", "action_time", "source_locator", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^LLR-[A-Z0-9-]+$" },
    "measure_identifier": { "type": "string", "minLength": 1 },
    "congress": { "type": "string", "pattern": "^[0-9]+$" },
    "action_type": { "enum": ["INTRODUCED", "REFERRED", "REPORTED", "AMENDED", "PASSED_HOUSE", "PASSED_SENATE", "PRESENTED", "ENACTED", "VETOED", "FAILED", "OTHER"] },
    "action_time": { "type": "string", "format": "date-time" },
    "source_locator": { "type": "string", "minLength": 1 },
    "status": { "enum": ["OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
