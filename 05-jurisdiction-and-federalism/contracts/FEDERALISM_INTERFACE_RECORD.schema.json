{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federalism Interface Record",
  "type": "object",
  "required": ["record_id", "participants", "action_subject", "authority_basis_refs", "boundary_statement", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^FIR-[A-Z0-9-]+$" },
    "participants": { "type": "array", "minItems": 2, "items": { "type": "string" } },
    "action_subject": { "type": "string", "minLength": 1 },
    "authority_basis_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "boundary_statement": { "type": "string", "minLength": 1 },
    "conflict_rule_ref": { "type": "string" },
    "status": { "enum": ["PROPOSED", "OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
