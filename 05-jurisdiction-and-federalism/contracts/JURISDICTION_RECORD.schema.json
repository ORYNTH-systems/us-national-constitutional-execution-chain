{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jurisdiction Record",
  "type": "object",
  "required": ["record_id", "actor_ref", "authority_basis_refs", "subject_scope", "geographic_scope", "institutional_boundary", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^JUR-[A-Z0-9-]+$" },
    "actor_ref": { "type": "string", "minLength": 1 },
    "authority_basis_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "subject_scope": { "type": "string", "minLength": 1 },
    "geographic_scope": { "type": "string", "minLength": 1 },
    "institutional_boundary": { "type": "string", "minLength": 1 },
    "time_boundary": { "type": "string" },
    "conflict_rule_ref": { "type": "string" },
    "status": { "enum": ["PROPOSED", "OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
