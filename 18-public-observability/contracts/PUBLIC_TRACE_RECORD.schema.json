{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Trace Record",
  "type": "object",
  "required": ["record_id", "action_ref", "public_summary", "trace_links", "publication_state", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^PTR-[A-Z0-9-]+$" },
    "action_ref": { "type": "string", "minLength": 1 },
    "public_summary": { "type": "string", "minLength": 1 },
    "trace_links": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "publication_state": { "enum": ["PUBLIC", "PARTIALLY_RESTRICTED", "RESTRICTED_WITH_BASIS", "PENDING"] },
    "restriction_basis_ref": { "type": "string" },
    "review_route_ref": { "type": "string" },
    "status": { "enum": ["OBSERVED", "VERIFIED", "CONTESTED", "SUPERSEDED", "CLOSED"] }
  },
  "additionalProperties": false
}
