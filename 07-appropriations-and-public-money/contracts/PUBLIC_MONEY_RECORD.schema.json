{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public Money Record",
  "type": "object",
  "required": ["record_id", "stage", "amount", "currency", "purpose", "authority_refs", "actor_ref", "effective_time", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^PMR-[A-Z0-9-]+$" },
    "stage": { "enum": ["APPROPRIATION", "APPORTIONMENT", "ALLOTMENT", "OBLIGATION", "COMMITMENT", "PAYMENT", "RECOVERY", "CLOSEOUT"] },
    "amount": { "type": "number", "minimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "purpose": { "type": "string", "minLength": 1 },
    "authority_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "actor_ref": { "type": "string", "minLength": 1 },
    "effective_time": { "type": "string", "format": "date-time" },
    "upstream_record_ref": { "type": "string" },
    "status": { "enum": ["PROPOSED", "OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
