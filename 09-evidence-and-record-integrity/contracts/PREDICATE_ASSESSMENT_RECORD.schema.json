{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Predicate Assessment Record",
  "type": "object",
  "required": ["record_id", "predicate_statement", "evidence_refs", "assessment_state", "assessment_time", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^PAR-[A-Z0-9-]+$" },
    "predicate_statement": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "assessment_state": { "enum": ["SATISFIED", "UNSATISFIED", "UNRESOLVED", "CONFLICTED", "EXPIRED"] },
    "assessment_time": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "status": { "enum": ["OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
