{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Election Event Record",
  "type": "object",
  "required": ["record_id", "event_type", "jurisdiction_record_id", "authority_source_ids", "responsible_office_record_id", "occurred_at", "provenance"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "event_type": { "enum": ["registration", "administration", "count", "audit", "recount", "certification", "challenge", "finality"] },
    "jurisdiction_record_id": { "type": "string", "minLength": 1 },
    "authority_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "responsible_office_record_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "provenance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "related_event_ids": { "type": "array", "items": { "type": "string" } },
    "public_trace_record_id": { "type": "string" }
  },
  "additionalProperties": false
}