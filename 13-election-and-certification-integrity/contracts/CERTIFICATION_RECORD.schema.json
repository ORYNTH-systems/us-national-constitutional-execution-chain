{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Certification Record",
  "type": "object",
  "required": ["record_id", "election_event_record_id", "authority_source_ids", "responsible_office_record_id", "scope", "issued_at", "count_or_audit_provenance", "challenge_route", "status"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "election_event_record_id": { "type": "string", "minLength": 1 },
    "authority_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "responsible_office_record_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "count_or_audit_provenance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "challenge_route": { "type": "string", "minLength": 1 },
    "status": { "enum": ["issued", "under_review", "superseded", "finality_claimed", "corrected"] },
    "finality_basis": { "type": "string" },
    "public_trace_record_id": { "type": "string" }
  },
  "additionalProperties": false
}