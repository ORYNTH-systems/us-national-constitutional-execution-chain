{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emergency Activation Record",
  "type": "object",
  "required": ["record_id", "authority_source_ids", "predicate_record_id", "responsible_office_record_id", "jurisdiction_record_id", "scope", "ordinary_constraint_affected", "starts_at", "ends_at_or_condition", "review_route", "status"],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "authority_source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "predicate_record_id": { "type": "string", "minLength": 1 },
    "responsible_office_record_id": { "type": "string", "minLength": 1 },
    "jurisdiction_record_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "ordinary_constraint_affected": { "type": "string", "minLength": 1 },
    "starts_at": { "type": "string", "format": "date-time" },
    "ends_at_or_condition": { "type": "string", "minLength": 1 },
    "review_route": { "type": "string", "minLength": 1 },
    "renewal_record_ids": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["asserted", "active", "expired", "terminated", "invalidated"] }
  },
  "additionalProperties": false
}