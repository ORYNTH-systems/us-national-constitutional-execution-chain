{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Office and Role Record",
  "type": "object",
  "required": ["record_id", "office_or_role", "institution", "authority_source_refs", "status", "valid_from"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^ORR-[A-Z0-9-]+$" },
    "office_or_role": { "type": "string", "minLength": 1 },
    "institution": { "type": "string", "minLength": 1 },
    "authority_source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "appointment_or_selection_ref": { "type": "string" },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "status": { "enum": ["OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
