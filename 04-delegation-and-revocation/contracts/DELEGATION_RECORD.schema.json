{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegation and Revocation Record",
  "type": "object",
  "required": ["record_id", "delegator_ref", "delegate_ref", "authority_basis_refs", "scope", "valid_from", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^DLR-[A-Z0-9-]+$" },
    "delegator_ref": { "type": "string", "minLength": 1 },
    "delegate_ref": { "type": "string", "minLength": 1 },
    "authority_basis_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scope": { "type": "string", "minLength": 1 },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "revocation_ref": { "type": "string" },
    "status": { "enum": ["PROPOSED", "OBSERVED", "VERIFIED", "CONTESTED", "REVOKED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
