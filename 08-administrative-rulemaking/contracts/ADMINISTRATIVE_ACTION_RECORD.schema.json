{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Administrative Action Record",
  "type": "object",
  "required": ["record_id", "action_kind", "agency_ref", "authority_refs", "procedure_refs", "effective_time", "status"],
  "properties": {
    "record_id": { "type": "string", "pattern": "^AAR-[A-Z0-9-]+$" },
    "action_kind": { "enum": ["PROPOSED_RULE", "FINAL_RULE", "GUIDANCE", "ORDER", "ADJUDICATION", "ENFORCEMENT_ACTION", "WAIVER", "EXCEPTION", "OTHER"] },
    "agency_ref": { "type": "string", "minLength": 1 },
    "authority_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "procedure_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "effective_time": { "type": "string", "format": "date-time" },
    "review_route_ref": { "type": "string" },
    "status": { "enum": ["PROPOSED", "OBSERVED", "VERIFIED", "CONTESTED", "INVALIDATED", "CLOSED"] }
  },
  "additionalProperties": false
}
